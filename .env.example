# Discord Bot Token (required)
DISCORD_TOKEN=your_discord_bot_token_here

# Interlink ConnectRPC Configuration
# Connect to the Apollo Interlink gRPC service
INTERLINK_ADDRESS=http://interlink:8080
# Shared secret for HMAC-SHA256 authentication (min 32 chars)
INTERLINK_AUTH_KEY=your_shared_secret_key_here_min_32_chars
# Bot identifier for registration
INTERLINK_BOT_ID=nrp-time-bot